  "agents": {
    "kinds": [
      {
        "id": "households",
        "title": "Households and people",
        "actor": "agent",
        "summary": "Eight households of people. A household decides how much of its money to spend each month and which shop gets it. People do not choose jobs one by one: firms hire from the unemployed (cheapest reservation wage first, ties to higher skill). A household's class is a label worked out from what it owns and earns; it is never chosen.",
        "decides": [
          "How much to spend on food, goods and services this month",
          "Which firm in each sector gets that spending",
          "Whether to found a firm in the dormant slot (a Worker or Manager household with enough savings)",
          "Capital-owning households: how much to give lobbying"
        ],
        "observes": [
          "Its savings and last disposable income",
          "Every shop's price and stock",
          "The interest rate, firms' profit and unmet demand (for founding a firm)"
        ],
        "rule": "food = min(need x food price, savings); discretionary = min(propensity x max(0, disposable - food need) + wealth spending, savings - food); services = services share x discretionary; goods = the rest. Shop weight = stock x (average price / price) ^ elasticity, where the average price is weighted by stock",
        "params": [
          {
            "path": "goods.food_need_units_pc",
            "label": "Food need per person",
            "value": 25,
            "unit": "units per month"
          },
          {
            "path": "goods.price_elasticity",
            "label": "Price elasticity of shop choice",
            "value": 2,
            "unit": "exponent"
          },
          {
            "path": "goods.services_share",
            "label": "Share of discretionary spending on services",
            "value": 0.45,
            "unit": "share"
          },
          {
            "path": "goods.wealth_consumption_rate",
            "label": "Capitalists and Rentiers: spending out of wealth",
            "value": 0.005,
            "unit": "share of net wealth per month"
          },
          {
            "path": "goods.propensity.worker",
            "label": "Spending propensity, Worker",
            "value": 1,
            "unit": "share"
          },
          {
            "path": "goods.propensity.capitalist",
            "label": "Spending propensity, Capitalist",
            "value": 0.45,
            "unit": "share"
          }
        ],
        "variants": [
          {
            "id": "capitalist",
            "label": "Capitalist",
            "decision": "Owns firms or the bank and lives mostly on profit; spends only part of income and funds lobbying.",
            "rule": "owns assets and capital share of recent income above the threshold, rent not the main part"
          },
          {
            "id": "rentier",
            "label": "Rentier",
            "decision": "Lives mostly on rent from homes it lets; spends part of income and funds lobbying.",
            "rule": "as Capitalist, but rent received is above the rentier share of capital income"
          },
          {
            "id": "manager",
            "label": "Manager",
            "decision": "Skilled and well paid; spends most of income and is the person who receives lobbying money.",
            "rule": "employed, top skill above the skill threshold and pay above the skilled wage ratio times the base wage"
          },
          {
            "id": "worker",
            "label": "Worker",
            "decision": "Lives on wages; spends nearly all income, buying food first.",
            "rule": "employed and not Manager"
          },
          {
            "id": "dependent",
            "label": "Dependent",
            "decision": "No one in the household has a job; lives on benefits and savings, food first.",
            "rule": "no employed member, and not a Capitalist or Rentier"
          }
        ],
        "classParams": [
          {
            "path": "class.capital_share_threshold",
